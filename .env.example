# Copy to .env.local and fill in. .env.local is git-ignored. Never commit real values.
# Firebase console > Project settings > General > Your apps > Orynti Web > SDK setup and configuration
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# reCAPTCHA v3 site key used when registering the web app in App Check (a public key, not a secret).
# initializeAppCheck requires a provider; on localhost the debug provider is used instead of attesting.
VITE_APPCHECK_RECAPTCHA_SITE_KEY=your-recaptcha-v3-site-key

# Optional: override the in-cloud model (default: gemini-3.5-flash-lite)
# VITE_CLOUD_MODEL=gemini-3.5-flash-lite
